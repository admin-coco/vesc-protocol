# ── Vault ──────────────────────────────────────────────────────────────────────
VAULT_ADDRESS=0x50f50cf026837ab49f337927d2b3269a7dedbc60
RPC_URL=https://mainnet.base.org

# ── Signer (rate updater wallet — keystore encrypted) ─────────────────────────
KEYSTORE_JSON={"address":"...","crypto":{...}}
KEYSTORE_PASSWORD=

# ── Binance P2P ────────────────────────────────────────────────────────────────
BINANCE_ROWS=20
BINANCE_MIN_ADS=10
BINANCE_TIMEOUT_MS=8000

# ── Oracle behaviour ───────────────────────────────────────────────────────────
INTERVAL_MINUTES=15
MAX_CHANGE_PCT=20
MIN_CHANGE_PCT=0.1
MAX_STALENESS_SEC=1500
MAX_SPREAD_PCT=12

# ── USDT/USDC circuit breaker ──────────────────────────────────────────────────
SPREAD_HALT_BPS=100

# ── Monitor (Telegram alerts) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── HTTP server ────────────────────────────────────────────────────────────────
PORT=3000
