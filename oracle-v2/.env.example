# ── Vault ──────────────────────────────────────────────────────────────────────
VAULT_ADDRESS=0x50f50cf026837ab49f337927d2b3269a7dedbc60
RPC_URL=https://mainnet.base.org
RPC_URL_FALLBACK=https://base.llamarpc.com

# ── Signer ────────────────────────────────────────────────────────────────────
# Preferred: plain hex private key (no 0x prefix)
ORACLE_PRIVATE_KEY=
# Legacy keystore fallback (unused if ORACLE_PRIVATE_KEY is set)
KEYSTORE_JSON={"address":"...","crypto":{...}}
KEYSTORE_PASSWORD=

# ── Binance P2P ────────────────────────────────────────────────────────────────
BINANCE_ROWS=20
BINANCE_MIN_ADS=15
BINANCE_TIMEOUT_MS=8000

# ── Oracle behaviour ───────────────────────────────────────────────────────────
INTERVAL_MINUTES=5
MAX_CHANGE_PCT=5
MIN_CHANGE_PCT=0.1
MAX_STALENESS_SEC=1500
MAX_SPREAD_PCT=4

# ── USDT/USDC circuit breaker ──────────────────────────────────────────────────
SPREAD_HALT_BPS=100

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated chat IDs to receive P2P order book snapshots after each cycle
BOOK_LOG_CHAT_IDS=

# ── HTTP server ────────────────────────────────────────────────────────────────
PORT=3000
